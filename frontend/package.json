{
  "name": "mailexpert-frontend",
  "productName": "MailExpert",
  "version": "3.3.0",
  "description": "A self-hosted, unified webmail client.",
  "homepage": "https://github.com/wyrtensi/MailExpert",
  "author": {
    "name": "wyrtensi",
    "email": "wyrtensi@users.noreply.github.com"
  },
  "type": "module",
  "main": "packages/electron/main.cjs",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/wyrtensi/MailExpert.git"
  },
  "keywords": [
    "Email",
    "Webmail",
    "Email Client",
    "Unified Inbox",
    "GUI"
  ],
  "license": "GPL-3.0",
  "bugs": {
    "url": "https://github.com/wyrtensi/MailExpert/issues"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "test": "node --test",
    "lint": "eslint src --max-warnings 0",
    "electron:dev": "electron .",
    "preelectron:dist": "node packages/scripts/prepare-electron-icons.cjs && node packages/scripts/prepare-linux-metainfo.cjs",
    "electron:dist": "electron-builder --publish never",
    "app:version": "node packages/scripts/set-app-version.cjs",
    "native:prepare": "npm run build && node packages/scripts/prepare-native-shell.cjs",
    "android:sync": "npm run native:prepare && node packages/scripts/sync-android.cjs",
    "android:dist": "npm run android:sync && node packages/scripts/build-android.cjs && node packages/scripts/collect-android-artifacts.cjs"
  },
  "build": {
    "appId": "sh.mailexpert.app",
    "productName": "MailExpert",
    "executableName": "MailExpert",
    "directories": {
      "output": "packages/release",
      "buildResources": "packages/electron/icons"
    },
    "icon": "icon",
    "protocols": [
      {
        "name": "MailExpert email link",
        "schemes": [
          "mailto"
        ]
      }
    ],
    "files": [
      "packages/electron/**/*",
      "packages/native-shell/**/*",
      "package.json"
    ],
    "win": {
      "artifactName": "${productName}-${version}-Setup.${ext}",
      "icon": "icon.ico",
      "target": [
        "nsis"
      ]
    },
    "nsis": {
      "include": "packages/electron/installer.nsh"
    },
    "mac": {
      "artifactName": "${productName}-${version}-Universal.${ext}",
      "target": [
        {
          "target": "dmg",
          "arch": [
            "universal"
          ]
        }
      ]
    },
    "linux": {
      "artifactName": "${productName}-${version}.${ext}",
      "target": [
        {
          "target": "deb",
          "arch": [
            "x64",
            "arm64"
          ]
        },
        {
          "target": "rpm",
          "arch": [
            "x64",
            "arm64"
          ]
        }
      ],
      "category": "Network",
      "desktop": {
        "entry": {
          "Name": "MailExpert",
          "StartupWMClass": "MailExpert"
        }
      }
    },
    "deb": {
      "packageName": "mailexpert",
      "artifactName": "${productName}-${version}-${arch}.${ext}",
      "maintainer": "wyrtensi <wyrtensi@users.noreply.github.com>",
      "vendor": "wyrtensi",
      "packageCategory": "net",
      "synopsis": "A self-hosted, unified webmail client.",
      "fpm": [
        "--replaces=mailexpert-frontend",
        "--conflicts=mailexpert-frontend",
        "packages/electron/package-type/deb=/opt/MailExpert/resources/package-type",
        "packages/electron/metainfo/sh.mailexpert.app.metainfo.xml=/usr/share/metainfo/sh.mailexpert.app.metainfo.xml"
      ]
    },
    "rpm": {
      "packageName": "mailexpert",
      "artifactName": "${productName}-${version}-${arch}.${ext}",
      "depends": [
        "libunity"
      ],
      "fpm": [
        "--replaces=mailexpert-frontend",
        "packages/electron/package-type/rpm=/opt/MailExpert/resources/package-type"
      ]
    }
  },
  "dependencies": {
    "@capacitor/android": "^8.5.2",
    "@capacitor/core": "^8.5.2",
    "@emoji-mart/data": "^1.2.1",
    "@tiptap/core": "^3.31.3",
    "@tiptap/extension-image": "^3.31.3",
    "@tiptap/extension-link": "^3.31.3",
    "@tiptap/extension-placeholder": "^3.31.3",
    "@tiptap/extension-table": "^3.31.3",
    "@tiptap/extension-table-cell": "^3.31.3",
    "@tiptap/extension-table-header": "^3.31.3",
    "@tiptap/extension-table-row": "^3.31.3",
    "@tiptap/extension-text-align": "^3.31.3",
    "@tiptap/extension-text-style": "^3.31.3",
    "@tiptap/react": "^3.31.3",
    "@tiptap/starter-kit": "^3.31.3",
    "date-fns": "^4.4.0",
    "dompurify": "^3.4.15",
    "emoji-mart": "^5.6.0",
    "i18next": "^26.4.2",
    "marked": "^18.0.13",
    "postcss": "^8.5.28",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-i18next": "^17.0.14",
    "react-router": "^7.18.3",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.5.2",
    "@eslint/js": "^10.0.1",
    "@tailwindcss/vite": "^4.3.3",
    "@vitejs/plugin-react": "^6.1.1",
    "electron": "^44.3.0",
    "electron-builder": "^26.15.3",
    "eslint": "^10.10.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.12.0",
    "jsdom": "^30.0.1",
    "tailwindcss": "^4.3.3",
    "vite": "^8.3.0"
  }
}
