{
  "name": "mailexpert-backend",
  "version": "3.3.0",
  "type": "module",
  "engines": {
    "node": ">=22 <23"
  },
  "scripts": {
    "start": "node src/index.js",
    "dev": "node --watch src/index.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint src --max-warnings 0",
    "lint:plugins": "eslint -c eslint.plugins-boundary.js src/plugins",
    "audit:redos": "npm i --no-save --silent eslint-plugin-redos && eslint -c eslint.redos.config.mjs src"
  },
  "dependencies": {
    "archiver": "^8.0.0",
    "bcryptjs": "^3.0.3",
    "connect-redis": "^10.0.0",
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "express-session": "^1.19.0",
    "fast-xml-parser": "^5.11.1",
    "htmlparser2": "^12.0.0",
    "imapflow": "^2.0.2",
    "jose": "^6.2.12",
    "nodemailer": "^10.0.9",
    "otplib": "^13.5.0",
    "pg": "^8.23.0",
    "qrcode": "^1.5.4",
    "redis": "^6.2.1",
    "sanitize-html": "^2.17.7",
    "undici": "^8.10.2",
    "web-push": "^3.6.7",
    "ws": "^8.21.3"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.10.0",
    "globals": "^17.12.0",
    "vitest": "^5.0.0"
  },
  "overrides": {
    "brace-expansion": "^5.0.8",
    "postcss": "^8.5.23"
  }
}
